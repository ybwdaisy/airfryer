---
import { t, localizeFood, localizedCategories } from '../../lib/i18n';
import { type Language } from '../../lib/locale';
import { regionHome, foodPath, categoryPath, defaultUnit } from '../../lib/region';
import Layout from '../../layouts/Layout.astro';
import FoodList from '../FoodList.astro';
import Measure from '../Measure.astro';
import { foodsForRegion } from '../../lib/foods';
import { temperature, minutes, preheatLabel, safetyGuides, safetySource } from '../../lib/format';
const lang: Language = Astro.props.lang ?? 'en';
const food = localizeFood(Astro.props.food, lang);
const region = food.region;
const unit = defaultUnit(region);
const categoryName = localizedCategories(lang, region).find(c => c.slug === food.category)!.name;
const related = foodsForRegion(region).filter(f => f.category === food.category && f.slug !== food.slug).slice(0, 4).map(f => localizeFood(f, lang));
const breadcrumb = [{name: categoryName, path: categoryPath(food.category, region, lang)}, {name: food.name, path: foodPath(food.slug, region, lang)}];
---
<Layout lang={lang} region={region} title={lang === 'zh' ? `${food.name}空气炸锅时间与温度 | Airfryer times` : `${food.name} air fryer time & temperature | Airfryer times`} description={food.description} breadcrumbs={breadcrumb}>
  <nav class="breadcrumbs" aria-label={t(lang, 'Breadcrumb')}><a href={regionHome(region, lang)}>{t(lang, 'All foods')}</a><span aria-hidden="true">/</span><a href={categoryPath(food.category, region, lang)}>{categoryName}</a></nav>
  <section class="page-intro detail-intro"><h1>{food.name}</h1><p><Measure text={food.description} unit={unit} lang={lang}/></p></section>
  {food.variants.length > 1 && <div class="condition-control js-only" hidden><label for="variant-select">{t(lang, 'Choose your starting condition')}</label><select id="variant-select" data-food-slug={food.slug}>{food.variants.map(v => <option value={v.id} data-measure={v.label}>{v.label}</option>)}</select><p class="field-help">{t(lang, 'Only separately sourced conditions are available.')}</p></div>}
  {food.variants.map(variant => {
    const safetyText = variant.safetyOverride?.text ?? (variant.state === 'reheat' ? t(lang, safetyGuides.leftovers) : food.safety ? t(lang, safetyGuides[food.safety]) : null);
    const safetyUrl = variant.safetyOverride?.url ?? safetySource;
    const sourcesAnchor = variant.id === food.variants[0].id ? 'sources' : `sources-${variant.id}`;
    const nativeUnit = variant.temperatureC === undefined ? 'f' : 'c';
    return <section class="variant-panel" data-variant-panel={variant.id} aria-labelledby={`condition-${variant.id}`}>
      <div class="detail-grid"><div class="cooking-guidance">
        <h2 id={`condition-${variant.id}`}><Measure text={variant.label} unit={unit} lang={lang}/></h2>
        <p class="portion"><Measure text={variant.portion} unit={unit} lang={lang}/></p>
        <section class="before-start"><h3>{t(lang, 'Before you start')}</h3>
          {variant.needsHob && <p class="notice dependency-note">{t(lang, 'This recipe needs a hob and pan; an air fryer alone is not enough.')}</p>}
          {variant.advancePreparation && <p class="advance-preparation"><Measure text={variant.advancePreparation} unit={unit} lang={lang}/></p>}
          {variant.requiresThermometer && <p class="equipment-note">{t(lang, 'Have a food thermometer ready; this guide uses it to confirm the finish.')}</p>}
          {variant.historical && <p class="notice">{t(lang, 'Preserved source condition: this uses a different preparation from the recommended first option.')}</p>}
          {variant.equipment && <div class="equipment-list"><h4>{t(lang, 'Tools')}</h4><ul>{variant.equipment.map(item => <li><Measure text={item} unit={unit} lang={lang}/></li>)}</ul></div>}
        </section>
        {variant.timeline && <section class="recipe-timeline"><h3>{t(lang, 'Timing by stage')}</h3><dl>{variant.timeline.map(stage => <div><dt>{stage.label}</dt><dd><Measure text={stage.detail} unit={unit} lang={lang}/></dd></div>)}</dl></section>}
        {variant.ingredients && <section class="ingredients"><h3>{t(lang, 'Ingredients')}</h3><ul>{variant.ingredients.map(item => <li><Measure text={item} unit={unit} lang={lang}/></li>)}</ul></section>}
        <section class="basket-settings"><h3>{t(lang, 'Air-frying stage')}</h3><dl class="cooking-values"><div><dt><span data-native-label={nativeUnit}>{t(lang, 'Air fryer setting')}</span><span data-converted-label={nativeUnit} hidden>{t(lang, 'Equivalent temperature (display only)')}</span></dt><dd data-temperature={variant.temperatureF} data-temperature-c={variant.temperatureC}>{temperature(variant.temperatureF, unit, variant.temperatureC)}</dd></div><div><dt>{t(lang, 'Time per batch')}</dt><dd>{minutes(variant.minutes)}<span> {t(lang, 'min')}</span></dd></div></dl>
          <p class="conversion-note" data-native-unit={nativeUnit} hidden={unit === nativeUnit}>{t(lang, 'Converted display only. Use a device with the recipe’s native setting; do not select the nearest notch or reuse the time at a different temperature.')} <button class="text-button" type="button" data-show-native-unit={nativeUnit}>{t(lang, 'Show the original setting')}</button></p>
          {variant.deviceNote && <p class="device-note"><Measure text={variant.deviceNote} unit={unit} lang={lang}/></p>}
          <dl class="cooking-facts"><div><dt>{t(lang, 'Preheat')}</dt><dd><Measure text={variant.preheatDetail ?? t(lang, preheatLabel(variant.preheat))} unit={unit} lang={lang}/></dd></div><div><dt>{t(lang, 'Turn or shake')}</dt><dd><Measure text={variant.turn} unit={unit} lang={lang}/></dd></div></dl>
        </section>
        <section class="instructions"><h3>{t(lang, 'Step by step')}</h3><ol>{variant.steps.map(step => <li><Measure text={step} unit={unit} lang={lang}/></li>)}</ol></section>
        {variant.completion && <section class="completion-check"><h3>{t(lang, 'How to check it is ready')}</h3><p><Measure text={variant.completion} unit={unit} lang={lang}/></p></section>}
        {variant.withoutThermometer && <section class="without-thermometer"><h3>{t(lang, 'Without a food thermometer')}</h3><p><Measure text={variant.withoutThermometer} unit={unit} lang={lang}/></p><a href="https://www.gov.uk/government/publications/cooking-your-food/cooking-your-food">{t(lang, 'Household checks: UK Food Standards Agency')}</a></section>}
        {variant.notes.length > 0 && <section class="reference-notes"><h3>{t(lang, 'Recipe notes')}</h3><ul>{variant.notes.map(note => <li><Measure text={note} unit={unit} lang={lang}/></li>)}</ul></section>}
      </div><aside class="detail-sidebar">
        <section class="safety-note"><h2>{t(lang, safetyText ? 'Check before serving' : 'Leave room for air')}</h2><p><Measure text={safetyText ?? t(lang, 'Use the preparation and quantity shown. Spread food evenly and avoid packing the basket tightly.')} unit={unit} lang={lang}/></p>{safetyText && <a href={safetyUrl}>{t(lang, 'Read the temperature guidance')}</a>}</section>
        <section class="source-summary"><h2>{t(lang, 'Where this guide comes from')}</h2><p>{t(lang, 'The reference below sets the displayed timing. A second source records comparable guidance and any differences.')}</p><a href={`#${sourcesAnchor}`}>{t(lang, 'Read the source notes')}</a></section>
      </aside></div>
      <section class="sources" id={`sources-${variant.id}`} data-source-panel={variant.id}>{variant.id === food.variants[0].id && <span id="sources" aria-hidden="true"></span>}<h2>{t(lang, 'Source notes')}</h2><p class="section-description">{t(lang, 'Reference research, not cooking tests by this site. Reviewed')} <time datetime={food.reviewedAt}>{food.reviewedAt}</time>.</p><p class="section-description">{t(lang, 'Source excerpts retain their original units; the cooking instructions above follow your selected display units.')}</p>
      {variant.sources.map(source => <details class="source-entry"><summary><span>{source.publisher}</span><small>{t(lang, source.role === 'reference' ? 'Timing reference' : 'Cross-check')}</small></summary><div class="source-body"><a href={source.url}>{source.title}</a><p>{source.evidence}</p><p class="source-locator">{t(lang, 'Location:')} {source.locator}</p></div></details>)}
      </section>
    </section>;
  })}
  {related.length > 0 && <section class="related"><div class="results-heading"><h2>{t(lang, 'More from this shelf')}</h2><a href={categoryPath(food.category, region, lang)}>{t(lang, 'View category')}</a></div><FoodList lang={lang} region={region} foods={related}/></section>}
  <script id="variant-data" type="application/json" set:html={JSON.stringify(food.variants).replaceAll('<', '\\u003c')}/>
  <script>import '../../scripts/detail.ts';</script>
</Layout>
