---
import { t, localizeFood, localizedCategories } from '../../lib/i18n';
import { localizedPath, type Language } from '../../lib/locale';
import { regionHome, foodPath, categoryPath, defaultUnit } from '../../lib/region';
import Layout from '../../layouts/Layout.astro';
import FoodList from '../FoodList.astro';
import Measure from '../Measure.astro';
import Icon from '../Icon.astro';
import EntryGuide from '../EntryGuide.astro';
import entryGuides from '../../data/entry-guides.json';
import { libraryFoods } from '../../lib/foods';
import { temperature, minutes, preheatLabel, safetyGuides, safetySource } from '../../lib/format';
import {variantPhases,sourceReminders,type CookingPlan} from '../../lib/cooking';
import {measureText} from '../../lib/measure';
const lang: Language = Astro.props.lang ?? 'en';
const food = localizeFood(Astro.props.food, lang);
const region = food.region;
const entry = entryGuides[food.slug as keyof typeof entryGuides];
const first = food.variants[0];
const setting = temperature(first.temperatureF, first.temperatureC === undefined ? 'f' : 'c', first.temperatureC);
const range = minutes(first.minutes).replace('-', '–');
const pageTitle = entry ? (lang==='zh' ? `${food.name}空气炸锅：${setting}，${range}分钟 | Airfryer times` : `${food.name} air fryer: ${setting}, ${range} min | Airfryer times`) : (lang==='zh' ? `${food.name}空气炸锅时间与温度 | Airfryer times` : `${food.name} air fryer time & temperature | Airfryer times`);
const pageDescription = entry ? `${entry[lang].condition} ${setting}, ${range}${lang==='zh'?'分钟/批。':' min per batch.'} ${entry[lang].description}` : food.description;
const relatedNames = Object.fromEntries(libraryFoods.map(f=>[f.slug,localizeFood(f,lang).name]));
const unit = defaultUnit(region);
const categoryName = localizedCategories(lang, region).find(c => c.slug === food.category)!.name;
const related = libraryFoods.filter(f => f.category === food.category && f.slug !== food.slug).map(f => localizeFood(f, lang));
const breadcrumb = [{name: categoryName, path: categoryPath(food.category, region, lang)}, {name: food.name, path: foodPath(food.slug, region, lang)}];
const plans:CookingPlan[] = food.variants.map(variant=>{
  const copyFor=(language:Language)=>{
    const f=localizeFood(Astro.props.food,language),v=f.variants.find(v=>v.id===variant.id)!;
    const measure=(s:string)=>measureText(s,unit,language,true);
    return {name:f.name,label:measure(v.label),portion:measure(v.portion),preparation:measure([
      v.needsHob?t(language,'This recipe needs a hob and pan; an air fryer alone is not enough.'):null,
      v.advancePreparation,v.requiresThermometer?t(language,'Have a food thermometer ready; this guide uses it to confirm the finish.'):null,
    ].filter(Boolean).join('\n')),preheat:measure(v.preheatDetail??t(language,preheatLabel(v.preheat))),turn:measure(v.turn),completion:measure(v.completion??''),withoutThermometer:measure(v.withoutThermometer??''),steps:v.steps.map(measure)};
  };
  const original=Astro.props.food.variants.find((v:{id:string})=>v.id===variant.id);
  return {slug:food.slug,condition:variant.id,path:foodPath(food.slug,region,'en'),unit,copy:{en:copyFor('en'),zh:copyFor('zh')},phases:variantPhases(variant),reminderSeconds:sourceReminders(original.turn,variantPhases(variant)[0].minutes[0]*60,Boolean(variant.cookingPhases))};
});
---
<Layout lang={lang} region={region} title={pageTitle} description={pageDescription} breadcrumbs={breadcrumb} modifiedAt={entry?.updatedAt}>
  <nav class="breadcrumbs" aria-label={t(lang, 'Breadcrumb')}><a href={regionHome(region, lang)}>{t(lang, 'All foods')}</a><span aria-hidden="true">/</span><a href={categoryPath(food.category, region, lang)}>{categoryName}</a></nav>
  <section class="page-intro detail-intro"><h1>{food.name}</h1><button class="favorite-button detail-favorite icon-button js-only" type="button" data-favorite={food.slug} data-food-name={food.name} aria-pressed="false" aria-label={`${t(lang,'Save recipe')}: ${food.name}`} hidden><Icon name="bookmark" size={22}/></button></section>
  {food.variants.length > 1 && <div class="condition-control js-only" hidden><label for="variant-select">{t(lang, 'Choose your starting condition')}</label><select id="variant-select" data-food-slug={food.slug}>{food.variants.map(v => <option value={v.id} data-measure={v.label}>{v.label}</option>)}</select></div>}
  {food.variants.map(variant => {
    const safetyText = variant.safetyOverride?.text ?? (variant.state === 'reheat' ? t(lang, safetyGuides.leftovers) : food.safety ? t(lang, safetyGuides[food.safety]) : null);
    const safetyUrl = variant.safetyOverride?.url ?? safetySource;
    const sourcesAnchor = variant.id === food.variants[0].id ? 'sources' : `sources-${variant.id}`;
    const nativeUnit = variant.temperatureC === undefined ? 'f' : 'c';
    return <section class="variant-panel" data-recipe-unit={nativeUnit} data-variant-panel={variant.id} aria-labelledby={`condition-${variant.id}`}>
      <div class="kitchen-mismatch" data-unsupported-note hidden><h2>{t(lang,'No matching method for your kitchen yet')}</h2><p>{t(lang, nativeUnit === 'c' ? 'This reference uses Celsius settings.' : 'This reference uses Fahrenheit settings.')} {t(lang,'This exact preparation is only sourced in the other temperature scale. We have not converted its setting or reused its time.')}</p><a href={`${regionHome(region,lang)}?q=${encodeURIComponent(food.name)}`}>{t(lang,'Find another recipe')}</a> <a href={localizedPath('/settings',lang)}>{t(lang,'Kitchen settings')}</a></div>
      <div class="detail-grid" data-compatible-body><div class="cooking-guidance">
        <h2 id={`condition-${variant.id}`}><Measure text={variant.label} unit={unit} lang={lang}/></h2>
        <p class="portion"><Measure text={variant.portion} unit={unit} lang={lang}/></p>
        <section class:list={['before-start',{'has-preparation':variant.needsHob||variant.advancePreparation||variant.requiresThermometer||variant.historical}]} data-recipe-section="preparation"><h3><Icon name="info" size={20}/>{t(lang, 'Before you start')}</h3>
          {variant.needsHob && <p class="notice dependency-note">{t(lang, 'This recipe needs a hob and pan; an air fryer alone is not enough.')}</p>}
          {variant.advancePreparation && <p class="advance-preparation"><Measure text={variant.advancePreparation} unit={unit} lang={lang}/></p>}
          {variant.requiresThermometer && <p class="equipment-note">{t(lang, 'Have a food thermometer ready; this guide uses it to confirm the finish.')}</p>}
          {variant.historical && <p class="notice">{t(lang, 'Preserved source condition: this uses a different preparation from the recommended first option.')}</p>}
          {variant.equipment && <details class="equipment-list"><summary><h4>{t(lang, 'Tools')}</h4></summary><ul>{variant.equipment.map(item => <li><Measure text={item} unit={unit} lang={lang}/></li>)}</ul></details>}
        </section>
        <section class="basket-settings" aria-label={t(lang, 'Air-frying stage')}>{(variant.cookingPhases ?? [{temperatureC:variant.temperatureC,minutes:variant.minutes}]).map((phase,i) => <div class="setting-stage">{variant.cookingPhases && <h4>{t(lang,'Stage')} {i+1}</h4>}<dl class="cooking-values"><div><dt><Icon name="thermometer" size={20}/>{t(lang, 'Temperature')}</dt><dd data-temperature={phase.temperatureC === undefined ? variant.temperatureF : phase.temperatureC*9/5+32} data-temperature-c={phase.temperatureC}>{temperature(phase.temperatureC === undefined ? variant.temperatureF : phase.temperatureC*9/5+32, unit, phase.temperatureC)}</dd></div><div><dt><Icon name="clock" size={20}/>{t(lang, variant.cookingPhases ? 'Time for this stage' : 'Time per batch')}</dt><dd>{minutes(phase.minutes)}<span> {t(lang, 'min')}</span></dd></div></dl></div>)}{variant.cookingPhases && <p class="phase-total">{t(lang,'Total air-frying time')}: {minutes(variant.minutes)} {t(lang,'min')}</p>}

          {variant.deviceNote && <p class="device-note"><Measure text={variant.deviceNote} unit={unit} lang={lang}/></p>}
          <dl class="cooking-facts"><div><dt>{t(lang, 'Preheat')}</dt><dd><Measure text={variant.preheatDetail ?? t(lang, preheatLabel(variant.preheat))} unit={unit} lang={lang}/></dd></div><div><dt>{t(lang, 'Turn or shake')}</dt><dd><Measure text={variant.turn} unit={unit} lang={lang}/></dd></div></dl>
          <button class="button cook-start js-only" type="button" data-cook-start={variant.id} hidden><Icon name="play" size={20}/><span data-cook-start-label>{lang==='zh'?'开始计时':'Start timer'}</span></button>
          <p class="cook-start-hint">{lang==='zh'?'按上方要求准备并入锅后，点击开始。':'Prepare and preheat as above. Start when the food is in the basket.'}</p>
        </section>
        {variant.timeline && <details class="recipe-timeline" data-recipe-section="timing"><summary><h3>{t(lang, 'Timing by stage')}</h3></summary><dl>{variant.timeline.map(stage => <div><dt>{stage.label}</dt><dd><Measure text={stage.detail} unit={unit} lang={lang}/></dd></div>)}</dl></details>}
        {variant.ingredients && <section class="ingredients" data-recipe-section="ingredients"><h3><Icon name="utensils"/>{t(lang, 'Ingredients')}</h3><ul>{variant.ingredients.map(item => <li><Measure text={item} unit={unit} lang={lang}/></li>)}</ul></section>}
        <section class="instructions" data-recipe-section="instructions"><h3><Icon name="book"/>{t(lang, 'Step by step')}</h3><ol role="list">{variant.steps.map(step => <li><Measure text={step} unit={unit} lang={lang}/></li>)}</ol></section>
        {variant.completion && <section class="completion-check" data-recipe-section="completion"><h3><Icon name="check"/>{t(lang, 'How to check it is ready')}</h3><p><Measure text={variant.completion} unit={unit} lang={lang}/></p></section>}
        {variant.withoutThermometer && <section class="without-thermometer" data-recipe-section="without_thermometer"><h3>{t(lang, 'Without a food thermometer')}</h3><p><Measure text={variant.withoutThermometer} unit={unit} lang={lang}/></p><a href="https://www.gov.uk/government/publications/cooking-your-food/cooking-your-food">{t(lang, 'Household checks: UK Food Standards Agency')}</a></section>}
        <section class="reference-notes"><h3>{t(lang, 'Recipe notes')}</h3><p><Measure text={food.description} unit={unit} lang={lang}/></p>{variant.notes.length > 0 && <ul>{variant.notes.map(note => <li><Measure text={note} unit={unit} lang={lang}/></li>)}</ul>}</section>
        {entry && variant.id===first.id && <EntryGuide slug={food.slug as keyof typeof entryGuides} lang={lang} names={relatedNames}/>}
      </div><aside class="detail-sidebar">
        <section class="safety-note"><h2>{t(lang, safetyText ? 'Check before serving' : 'Leave room for air')}</h2><p><Measure text={safetyText ?? t(lang, 'Use the preparation and quantity shown. Spread food evenly and avoid packing the basket tightly.')} unit={unit} lang={lang}/></p>{safetyText && <a href={safetyUrl}>{t(lang, 'Read the temperature guidance')}</a>}</section>
        <section class="source-summary"><a href={`#${sourcesAnchor}`}>{t(lang, 'Read the source notes')}</a></section>
      </aside></div>
      <section class="sources" id={`sources-${variant.id}`} data-source-panel={variant.id}>{variant.id === food.variants[0].id && <span id="sources" aria-hidden="true"></span>}<h2>{t(lang, 'Source notes')}</h2><p class="section-description">{t(lang, 'Reference research, not cooking tests by this site. Reviewed')} <time datetime={food.reviewedAt}>{food.reviewedAt}</time>.</p>
      {variant.sources.map(source => <details class="source-entry" data-source-role={source.role}><summary><span>{source.publisher}</span><small>{t(lang, source.role === 'reference' ? 'Timing reference' : 'Cross-check')}</small></summary><div class="source-body"><a href={source.url}>{source.title}</a><p>{source.evidence}</p><p class="source-locator">{t(lang, 'Location:')} {source.locator}</p></div></details>)}
      </section>
    </section>;
  })}
  {related.length > 0 && <section class="related"><div class="results-heading"><h2>{t(lang, 'More from this shelf')}</h2><a href={categoryPath(food.category, region, lang)}>{t(lang, 'View category')}</a></div><FoodList lang={lang} region={region} foods={related}/></section>}
  <script id="variant-data" data-food-slug={food.slug} data-food-category={food.category} type="application/json" set:html={JSON.stringify(food.variants).replaceAll('<', '\\u003c')}/>
  <script id="cooking-plans" type="application/json" set:html={JSON.stringify(plans).replaceAll('<', '\\u003c')}/>
  <script>import '../../scripts/detail.ts';</script>
</Layout>
