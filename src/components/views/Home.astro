---
import { t, localizeFood, localizedCategories, searchAliases } from '../../lib/i18n';
import { resultLabel, type Language } from '../../lib/locale';
import { regionHome, foodPath, categoryPath, type Region } from '../../lib/region';
import Layout from '../../layouts/Layout.astro';
import FoodList from '../FoodList.astro';
import { libraryFoods } from '../../lib/foods';
const lang: Language = Astro.props.lang ?? 'en';
const region: Region = Astro.props.region ?? 'us';
const collection = libraryFoods;
const displayFoods = collection.map(f => localizeFood(f, lang));
const categories = localizedCategories(lang).filter(c => collection.some(f => f.category === c.slug));
const index = collection.map(f => ({ slug: f.slug, name: localizeFood(f, lang).name, aliases: searchAliases(f), category: f.category, unit: f.variants[0].temperatureC === undefined ? 'f' : 'c', path: foodPath(f.slug,f.region,lang) }));
---
<Layout lang={lang} region={region} title={t(lang, 'Air fryer cooking times & temperatures | Airfryer times')} description={t(lang, 'Find air fryer cooking times and temperatures for meat, vegetables and frozen favorites. Clear starting conditions, source links and food safety checks.')}>
  <div class="workbench">
    <section class="search-workspace" aria-label={t(lang, 'Find a food')}>
      <form class="search-form" id="food-search" role="search" method="get" action={regionHome(region, lang)}>
        <h1 id="page-title"><label for="search-input">{t(lang, 'Search a food')}</label></h1>
        <div class="search-controls"><div class="input-wrap">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7.5"/><path d="m16 16 5 5"/></svg>
          <input id="search-input" name="q" type="search" placeholder={t(lang,'Chicken wings, broccoli, frozen fries')} autocomplete="off" maxlength="120" aria-describedby="search-help"/>
        <button class="search-clear" type="button" data-clear-query aria-label={t(lang, 'Clear search')} hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div><button class="button" type="submit">{t(lang, 'Search')}</button></div>
        <p class="field-help" id="search-help">{t(lang, 'Search by name or choose a category below.')}</p>
      <div class="search-examples js-only" hidden>{(['Wings', 'Sweet potato', 'Fries']).map(term => <button type="button" data-search-example={t(lang, term)}>{t(lang, term)}</button>)}</div>
      </form>
      <nav class="category-filter" aria-label={t(lang, 'Food categories')}>
        <a href={regionHome(region, lang)} data-category-filter="all" aria-current="page">{t(lang, 'All foods')}</a>
        {categories.map(c => <a href={categoryPath(c.slug, region, lang)} data-category-filter={c.slug}>{c.short}</a>)}
      </nav>

      <div class="results-heading"><h2 id="results-title" class="visually-hidden">{t(lang, 'Cooking guides')}</h2><p id="result-count" role="status" aria-live="polite">{resultLabel(displayFoods.length, false, lang)}</p><span class="kitchen-summary" data-kitchen-summary></span></div>
      <p class="search-scope-note" data-category-search-hint hidden>{t(lang, 'Matches exist in another category.')} <button class="text-button" data-reset-category type="button">{t(lang, 'Search all categories')}</button></p>

      <FoodList lang={lang} region={region} foods={displayFoods} searchable/>
      <div class="unavailable-results" data-unavailable-results aria-live="polite" hidden><h3>{t(lang,'More matching foods')}</h3><p>{t(lang,'These foods do not yet have a verified method for your kitchen temperature scale.')}</p><ul data-unavailable-list></ul></div>
      <noscript><p class="notice">{t(lang, 'Live search needs JavaScript. You can browse every guide below or use the category links.')}</p></noscript>

    </section>

  </div>
  <script id="food-index" type="application/json" set:html={JSON.stringify(index).replaceAll('<', '\\u003c')}/>
  <script>import '../../scripts/search.ts';</script>
</Layout>
