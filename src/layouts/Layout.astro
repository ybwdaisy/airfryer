---
import '../styles/app.css';
import Consent from '../components/Consent.astro';
import { t } from '../lib/i18n';
import { localizedPath, type Language } from '../lib/locale';
import { regionFromPath, regionHome, regionName, defaultUnit, switchLanguagePath, type Region } from '../lib/region';
interface Props { title: string; description: string; breadcrumbs?: { name: string; path: string }[]; noindex?: boolean; lang?: Language; region?: Region }
const { title, description, breadcrumbs = [], noindex = false, lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);
const origin = 'https://airfryer.ybwdaisy.com';
const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, origin).href;

const otherLanguage = lang === 'en' ? 'zh' : 'en';
const region = Astro.props.region ?? regionFromPath(cleanPath);
const initialUnit = defaultUnit(region);
const englishUrl = new URL(switchLanguagePath(cleanPath, region, 'en'), origin).href;
const chineseUrl = new URL(switchLanguagePath(cleanPath, region, 'zh'), origin).href;
const home = regionHome(region, lang);
const isProduction = import.meta.env.PROD && process.env.VERCEL_ENV === 'production';
const candidate = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';
const gaId = isProduction && /^G-[A-Z0-9]+$/.test(candidate) ? candidate : '';
const schema = breadcrumbs.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [{ name: t(lang, 'All foods'), path: home }, ...breadcrumbs].map((b, i) => ({
    '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(lp(b.path), origin).href,
  })),
} : { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Airfryer times', url: origin, description };
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-region={region} data-default-unit={initialUnit}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/dm-sans-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcf9f4" />
    <meta name="ga-measurement-id" content={gaId} />
    {(!isProduction || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=1" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="Airfryer times" />
    <meta name="apple-mobile-web-app-title" content="Airfryer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'Skip to content')}</a>
    <header class="site-header container">
      <a class="wordmark" href={home} data-region-home aria-label={t(lang, 'Airfryer times home')}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v3m-6-1 1.5 2M18 5l-1.5 2M5 11h14v5a5 5 0 0 1-5 5h-4a5 5 0 0 1-5-5zM9 15h6" /></svg>
        Airfryer <span class="wordmark-tail">times</span>
      </a>
      <nav class="header-nav" aria-label={t(lang, 'Main navigation')}>
        <a href={home} data-region-home>{t(lang, 'All foods')}</a>
        <a href={lp('/methodology')}>{t(lang, 'Our sources')}</a>
      </nav>
      <div class="header-controls">
      <a class="language-toggle" href={switchLanguagePath(cleanPath, region, otherLanguage)} data-language-switch={otherLanguage} data-language-path={noindex && cleanPath.endsWith('/404') ? cleanPath : undefined} hreflang={otherLanguage === 'zh' ? 'zh-CN' : 'en'} aria-label={lang === 'en' ? 'Switch to Chinese' : '切换到英文'}><span lang={otherLanguage === 'zh' ? 'zh-CN' : 'en'}>{lang === 'en' ? '中文' : 'EN'}</span></a>
      <div class="unit-switch js-only" role="group" aria-label={t(lang, 'Measurement units')} hidden>
        <button type="button" data-unit="f" aria-pressed={initialUnit === 'f' ? 'true' : 'false'} title={t(lang, 'Fahrenheit, ounces and inches')}>°F</button>
        <button type="button" data-unit="c" aria-pressed={initialUnit === 'c' ? 'true' : 'false'} title={t(lang, 'Celsius, grams and centimeters')}>°C</button>
      </div>
      </div>
    </header>
    <div class="collection-toolbar container">
      <nav class="collection-switch" aria-label={t(lang, 'Food collection')}>
        <span>{t(lang, 'Food collection')}</span>
        {(['cn', 'us'] as const).map(value => <a href={regionHome(value, lang)} data-region-select={value} aria-current={region === value ? 'page' : undefined}>{regionName(value, lang)}</a>)}
      </nav>
      <p class="unit-caption"><span data-unit-caption="c" hidden={initialUnit !== 'c'}>{t(lang, 'Metric: °C, g, cm')}</span><span data-unit-caption="f" hidden={initialUnit !== 'f'}>{t(lang, 'US units: °F, oz, inches')}</span></p>
    </div>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>{t(lang, 'Cooking times are a starting point. Check doneness before serving.')}</p>
      <nav aria-label={t(lang, 'Footer navigation')}>
        <a href={lp('/methodology')}>{t(lang, 'Sources & safety')}</a>
        <a href={lp('/privacy')}>{t(lang, 'Privacy')}</a>
        <button type="button" class="text-button js-only" data-privacy-settings hidden>{t(lang, 'Analytics choices')}</button>
      </nav>
    </footer>
    <Consent lang={lang} />
    <script>
      import '../scripts/shared.ts';
    </script>
  </body>
</html>
