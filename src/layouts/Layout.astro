---
import Consent from '../components/Consent.astro';
import Icon from '../components/Icon.astro';
import Cooking from '../components/Cooking.astro';
import { t } from '../lib/i18n';
import { localizedPath, type Language } from '../lib/locale';
import { regionFromPath, regionHome, defaultUnit, switchLanguagePath, type Region } from '../lib/region';
interface Props { title: string; description: string; breadcrumbs?: { name: string; path: string }[]; noindex?: boolean; lang?: Language; region?: Region; modifiedAt?: string }
const { title, description, breadcrumbs = [], noindex = false, lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);
const origin = 'https://airfryer.ybwdaisy.com';
const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonicalPath = cleanPath === '/china' ? '/' : cleanPath === '/zh/us' ? '/zh' : cleanPath.replace('/china/categories/', '/categories/');
const canonical = new URL(canonicalPath, origin).href;

const region = Astro.props.region ?? regionFromPath(cleanPath);
const initialUnit = defaultUnit(region);
const englishUrl = new URL(switchLanguagePath(canonicalPath, region, 'en'), origin).href;
const chineseUrl = new URL(switchLanguagePath(canonicalPath, region, 'zh'), origin).href;
const home = regionHome(region, lang);
const isProduction = import.meta.env.PROD && process.env.VERCEL_ENV === 'production';
const candidate = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';
const gaId = isProduction && /^G-[A-Z0-9]+$/.test(candidate) ? candidate : '';
const pageSchema = Astro.props.modifiedAt ? {'@context':'https://schema.org','@type':'WebPage',url:canonical,name:title,description,inLanguage:lang==='zh'?'zh-CN':'en',dateModified:Astro.props.modifiedAt,isPartOf:{'@type':'WebSite',name:'Airfryer times',url:origin}} : null;
const schema = breadcrumbs.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [{ name: t(lang, 'All foods'), path: home }, ...breadcrumbs].map((b, i) => ({
    '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(lp(b.path), origin).href,
  })),
} : { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Airfryer times', url: origin, description };
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-region={region} data-default-unit={initialUnit}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/dm-sans-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcf9f4" />
    <meta name="ga-measurement-id" content={gaId} />
    {(!isProduction || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="icon" href="/favicon.ico?v=3" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    <meta name="application-name" content="Airfryer times" />
    <meta name="apple-mobile-web-app-title" content="Airfryer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />
    {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema).replaceAll('<', '\\u003c')}/>}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'Skip to content')}</a>
    <header class="site-header container">
      <a class="wordmark" href={home} data-region-home aria-label={t(lang, 'Airfryer times home')}>
        <img class="brand-mark" src="/logo.svg" width="32" height="32" alt="" aria-hidden="true"/>
        Airfryer <span class="wordmark-tail">times</span>
      </a>

      <div class="header-controls">
      <a class="settings-link saved-link js-only" href={`${home}?filter=saved`} aria-label={t(lang,'Saved recipes')} hidden><Icon name="bookmark" size={20}/><span class="header-saved-label">{t(lang,'Saved recipes')}</span> <span data-saved-count>0</span></a>
      <a class="settings-link" href={lp('/settings')} data-kitchen-settings><Icon name="settings" size={20}/>{t(lang,'Settings')}</a>
      </div>
    </header>
    <main id="main" class="container">
      <noscript><p class="notice">{t(lang,'Kitchen settings need JavaScript. Without it, recipes keep their original-source units.')}</p></noscript>
      <slot />
    </main>
    <footer class="site-footer container">
      <p>{t(lang, 'Cooking times are a starting point. Check doneness before serving.')}</p>
      <nav aria-label={t(lang, 'Footer navigation')}>
        <a href={lp('/methodology')}>{t(lang, 'Sources & safety')}</a>
        <a href={lp('/privacy')}>{t(lang, 'Privacy')}</a>
        <a href="https://github.com/ybwdaisy/airfryer" target="_blank" rel="noopener noreferrer" aria-label={lang==='zh'?'GitHub 源码（新窗口）':'Source code on GitHub (opens in a new tab)'}>GitHub</a>
        <button type="button" class="text-button js-only" data-privacy-settings hidden>{t(lang, 'Analytics choices')}</button>
      </nav>
    </footer>
    <details class="photo-credits container" data-credits><summary>{lang==='zh'?'分类图片来源':'Category photographs'}</summary><p>{lang==='zh'?'Wikimedia Commons 分类示意图片，非本站菜谱实测成品。':'Category illustrations from Wikimedia Commons, not results of recipe tests by this site.'}</p><ul>
      <li><a href="https://commons.wikimedia.org/wiki/File:Home-made_chicken_wings.jpg">JIP: Home-made chicken wings</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></li>
      <li><a href="https://commons.wikimedia.org/wiki/File:Raw_salmon_fillets.jpg">FULVIO_TOGNON: Raw salmon fillets</a>, CC0</li>
      <li><a href="https://commons.wikimedia.org/wiki/File:Broccoli.jpg">USDA Lance Cheung: Broccoli</a>, <a href="https://creativecommons.org/licenses/by/2.0/">CC BY 2.0</a></li>
      <li><a href="https://commons.wikimedia.org/wiki/File:French_Fries.JPG">StockSnap: French Fries</a>, CC0</li>
      <li><a href="https://commons.wikimedia.org/wiki/File:6312_sourdough_bread.jpg">Virtual-Pano: Sourdough bread</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></li>
      <li><a href="https://commons.wikimedia.org/wiki/File:Homemade_Pizza.jpg">Alanthebox: Homemade Pizza</a>, CC0</li>
    </ul><p>{lang==='zh'?'仅缩略展示及 CSS 裁切；照片各自保留上述许可。':'Thumbnail display and CSS crops only; each photograph retains its stated license.'}</p></details>
    <Consent lang={lang} />
    <p class="favorite-status container" data-favorite-status role="status" aria-live="polite"></p>
    <Cooking lang={lang}/>
    <script>
      import '../scripts/shared.ts';
      import '../scripts/favorites.ts';
      import '../scripts/cooking.ts';
    </script>
  </body>
</html>
<style is:global>
  @import '../styles/app.css';
</style>
