---
import Layout from '../layouts/Layout.astro';
import FoodList from '../components/FoodList.astro';
import { orderedFoods, categories } from '../lib/foods';
import { temperature, minutes } from '../lib/format';
const featured = orderedFoods[0];
const featuredVariant = featured?.variants[0];
const index = orderedFoods.map(f => ({ slug: f.slug, name: f.name, aliases: f.aliases, category: f.category }));
---
<Layout title="Air fryer cooking times & temperatures | Airfryer times" description="Find air fryer cooking times and temperatures for meat, vegetables and frozen favorites. Clear starting conditions, source links and food safety checks.">
  <section class="page-intro" aria-labelledby="page-title">
    <h1 id="page-title">What’s going in the air fryer?</h1>
    <p>Find the temperature, timing and when to turn.</p>
  </section>
  <div class="workbench">
    <section class="search-workspace" aria-label="Find a food">
      <form class="search-form" id="food-search" role="search" method="get" action="/">
        <label for="search-input">Search a food</label>
        <div class="search-controls">
          <div class="input-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7.5" /><path d="m16 16 5 5" /></svg>
            <input id="search-input" name="q" type="search" placeholder="Chicken wings, broccoli, frozen fries" autocomplete="off" maxlength="120" aria-describedby="search-help" />
          </div>
          <button class="button" type="submit">Find times</button>
        </div>
        <p class="field-help" id="search-help">Search by name or choose a category below.</p>
      </form>
      <nav class="category-filter" aria-label="Food categories">
        <a href="/" data-category-filter="all" aria-current="page">All foods</a>
        {categories.map(c => <a href={`/categories/${c.slug}`} data-category-filter={c.slug}>{c.short}</a>)}
      </nav>
      <div class="results-heading"><h2 id="results-title">Cooking guides</h2><p id="result-count" role="status" aria-live="polite">{orderedFoods.length} foods</p></div>
      <FoodList foods={orderedFoods} searchable />
      <noscript><p class="notice">Live search needs JavaScript. You can browse every guide below or use the category links.</p></noscript>
      <p class="list-note">Each time applies to the starting condition shown. Open a guide for quantities and source notes.</p>
    </section>
    <aside class="kitchen-notes">
      {featured && featuredVariant && <section class="featured-guide" aria-labelledby="featured-title">
        <h2 id="featured-title">Start with {featured.name.toLowerCase()}</h2>
        <p>{featuredVariant.label}</p>
        <dl class="featured-values">
          <div><dt>Temperature</dt><dd data-temperature={featuredVariant.temperatureF}>{temperature(featuredVariant.temperatureF, 'f')}</dd></div>
          <div><dt>Cooking time</dt><dd>{minutes(featuredVariant.minutes)}<span> min</span></dd></div>
        </dl>
        <a class="featured-link" href={`/foods/${featured.slug}`}>See quantities & instructions</a>
      </section>}
      <section class="kitchen-tip">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14.5V5a3 3 0 0 1 6 0v9.5a5 5 0 1 1-6 0Z" /><path d="M12 9v9" /></svg>
        <h2>Time is a guide.<br />Temperature is the check.</h2>
        <p>Size, starting temperature and your air fryer can change the timing. Check meat with a food thermometer.</p>
        <a href="/methodology#food-safety">Read the safety checks</a>
      </section>
      <p class="source-note">Reference guides with linked sources. No claim of kitchen testing by this site.</p>
    </aside>
  </div>
  <script id="food-index" type="application/json" set:html={JSON.stringify(index).replaceAll('<', '\\u003c')} />
  <script>import '../scripts/search.ts';</script>
</Layout>
