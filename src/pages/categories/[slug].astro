---
import View from '../../components/views/CategoryPage.astro';
import { foodsForRegion, categories } from '../../lib/foods';
export function getStaticPaths() { return categories.filter(c => foodsForRegion('us').some(f => f.category === c.slug)).map(category => ({ params: { slug: category.slug }, props: { category } })); }
---
<View lang="en" region="us" category={Astro.props.category}/>
