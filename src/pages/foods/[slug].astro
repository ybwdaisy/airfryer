---
import Layout from '../../layouts/Layout.astro';
import FoodList from '../../components/FoodList.astro';
import { foods, categoryName } from '../../lib/foods';
import { temperature, minutes, preheatLabel, safetyGuides, safetySource } from '../../lib/format';
export function getStaticPaths() { return foods.map(food => ({ params: { slug: food.slug }, props: { food } })); }
const { food } = Astro.props;
const related = foods.filter(f => f.category === food.category && f.slug !== food.slug).slice(0, 4);
const breadcrumb = [{ name: categoryName(food.category), path: `/categories/${food.category}` }, { name: food.name, path: `/foods/${food.slug}` }];
---
<Layout title={`${food.name} air fryer time & temperature | Airfryer times`} description={`Air fryer time and temperature for ${food.name.toLowerCase()}, with starting conditions, turning instructions, source notes and doneness checks.`} breadcrumbs={breadcrumb}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">All foods</a><span aria-hidden="true">/</span><a href={`/categories/${food.category}`}>{categoryName(food.category)}</a></nav>
  <section class="page-intro detail-intro"><h1>{food.name}</h1><p>{food.description}</p></section>
  {food.variants.length > 1 && <div class="condition-control js-only" hidden>
    <label for="variant-select">Choose your starting condition</label>
    <select id="variant-select" data-food-slug={food.slug}>{food.variants.map(v => <option value={v.id}>{v.label}</option>)}</select>
    <p class="field-help">Only separately sourced conditions are available.</p>
  </div>}
  {food.variants.map(variant => {
    const safetyText = variant.safetyOverride?.text ?? (variant.state === 'reheat' ? safetyGuides.leftovers : food.safety ? safetyGuides[food.safety] : null);
    const safetyUrl = variant.safetyOverride?.url ?? safetySource;
    const sourcesAnchor = variant.id === food.variants[0].id ? 'sources' : `sources-${variant.id}`;
    return <section class="variant-panel" data-variant-panel={variant.id} aria-labelledby={`condition-${variant.id}`}>
      <div class="detail-grid">
        <div class="cooking-guidance">
          <h2 id={`condition-${variant.id}`}>{variant.label}</h2>
          <p class="portion">{variant.portion}</p>
          <dl class="cooking-values">
            <div><dt>Air fryer setting</dt><dd data-temperature={variant.temperatureF}>{temperature(variant.temperatureF, 'f')}</dd></div>
            <div><dt>Cooking time</dt><dd>{minutes(variant.minutes)}<span> min</span></dd></div>
          </dl>
          <p class="conversion-note">°C settings are rounded to the nearest 5°C. Start checking at the earlier time.</p>
          <dl class="cooking-facts">
            <div><dt>Preheat</dt><dd>{preheatLabel(variant.preheat)}</dd></div>
            <div><dt>Turn or shake</dt><dd>{variant.turn}</dd></div>
          </dl>
          <section class="instructions"><h3>At the basket</h3><ol>{variant.steps.map(step => <li>{step}</li>)}</ol></section>
          {variant.notes.length > 0 && <section class="reference-notes"><h3>Before you cook</h3><ul>{variant.notes.map(note => <li>{note}</li>)}</ul></section>}
        </div>
        <aside class="detail-sidebar">
          <section class="safety-note"><h2>{safetyText ? 'Check before serving' : 'Leave room for air'}</h2><p>{safetyText ?? 'Use the preparation and quantity shown. Spread food evenly and avoid packing the basket tightly.'}</p>{safetyText && <a href={safetyUrl}>Read the temperature guidance</a>}</section>
          <section class="source-summary"><h2>Where this guide comes from</h2><p>The reference below sets the displayed timing. A second source records comparable guidance and any differences.</p><a href={`#${sourcesAnchor}`}>Read the source notes</a></section>
        </aside>
      </div>
      <section class="sources" id={sourcesAnchor}>
        <h2>Source notes</h2>
        <p class="section-description">Reference research, not cooking tests by this site. Reviewed <time datetime={food.reviewedAt}>{food.reviewedAt}</time>.</p>
        {variant.sources.map(source => <details class="source-entry">
          <summary><span>{source.publisher}</span><small>{source.role === 'reference' ? 'Timing reference' : 'Cross-check'}</small></summary>
          <div class="source-body"><a href={source.url}>{source.title}</a><p>{source.evidence}</p><p class="source-locator">Location: {source.locator}</p></div>
        </details>)}
      </section>
    </section>;
  })}
  {related.length > 0 && <section class="related"><div class="results-heading"><h2>More from this shelf</h2><a href={`/categories/${food.category}`}>View category</a></div><FoodList foods={related} /></section>}
  <script id="variant-data" type="application/json" set:html={JSON.stringify(food.variants).replaceAll('<', '\\u003c')} />
  <script>import '../../scripts/detail.ts';</script>
</Layout>
