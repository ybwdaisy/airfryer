---
import View from '../../components/views/FoodPage.astro';
import { foodsForRegion } from '../../lib/foods';
export function getStaticPaths() { return foodsForRegion('us').map(food => ({ params: { slug: food.slug }, props: { food } })); }
---
<View lang="en" region="us" food={Astro.props.food}/>
