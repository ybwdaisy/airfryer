{
  "name": "airfryer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4327",
    "build": "node scripts/validate-data.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4327",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:language": "node tests/language.mjs",
    "test:production": "node scripts/check-production.mjs",
    "data:check": "node scripts/validate-data.mjs",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "astro": "^7.4.11",
    "fuse.js": "^7.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "puppeteer-core": "^25.17.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3"
  }
}
